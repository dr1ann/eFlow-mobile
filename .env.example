# These values are public client configuration. Do not add service-role,
# database, Cloudflare, SMTP, private AI, or Ollama credentials here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Development only. This never enables HTTP in production builds.
# EXPO_PUBLIC_ALLOW_INSECURE_LOCAL_GATEWAY=true

# Explicit per-operation mobile allow-list. Keep empty until the matching
# deployed allowed/denied probe has passed. This is presentation only; RLS/RPC
# authorization is always authoritative.
# EXPO_PUBLIC_PHASE_1_LIVE_CAPABILITIES=taskTransition,subtaskProgress,evidenceRules

# Development-only fixtures must never be enabled in a production build.
# EXPO_PUBLIC_PHASE_1_USE_FIXTURES=false

# Explicit Phase 2 rollout allow-list. Keep empty until the corresponding
# non-production allowed/denied RLS or RPC probe has passed. This is not an
# authorization bypass: the server remains authoritative.
# EXPO_PUBLIC_PHASE_2_LIVE_CAPABILITIES=projectCreate,projectComplete,projectArchive

# Explicit Phase 3 rollout allow-list. Keep empty until each matching
# contract has passed its allowed/denied probe. This never grants access.
# EXPO_PUBLIC_PHASE_3_LIVE_CAPABILITIES=notificationSummary

# Development-only Phase 3 fixtures must never be enabled in a production build.
# EXPO_PUBLIC_PHASE_3_USE_FIXTURES=false

# Used only by `npm run supabase:types`; it is not bundled into the app.
# SUPABASE_PROJECT_REF=your-project-ref

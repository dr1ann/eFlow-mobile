{
  "expo": {
    "name": "eFlow Mobile",
    "slug": "eflow-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "eflow",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow eFlow to select image evidence for your assigned work."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.jamesdenoy12.eflowmobile"
    }
  }
}
